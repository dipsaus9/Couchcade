{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The relay: one Worker plus the Room Durable Object. See docs/architecture/platform.md.
  // Deploys belong to CC-1.18 (GitHub Actions). Don't deploy from a laptop.
  "name": "couchcade",
  "main": "src/worker.ts",
  "account_id": "35ee53c3b77e566a5e8e2242f752f668",
  "compatibility_date": "2026-09-01",

  // One Durable Object per room code. SQLite-backed, so it runs on the Workers Free plan.
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // Speed bumps, not quotas (docs/architecture/security.md, "Rate limits"). Keys are per IP.
  // CC-2.3 applies them. namespace_id only has to be unique within the account.
  "ratelimits": [
    { "name": "RL_PASSCODE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_CREATE", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_JOIN", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_REJOIN", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_UPGRADE", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
  ],

  // Sampled logs, never one per message. Invocation logs are off because the /ws URL carries
  // the ticket, and query strings are redacted for the same reason.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
  },
}
